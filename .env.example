APP_NAME=Mentoris
APP_ENV=local
APP_DEBUG=true
APP_URL=http://mentoris.test
APP_KEY=
APP_TIMEZONE=Asia/Tehran

# MySQL 8+ (use a dedicated application user; never commit real credentials)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mentoris
DB_USERNAME=mentoris_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SSL_CA=

# Database-backed, encrypted sessions and shared rate limits are required in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=7200
SESSION_ROTATE_INTERVAL=900
RATE_LIMIT_DRIVER=database
TRUSTED_PROXIES=

PASSWORD_MEMORY_COST=65536
PASSWORD_TIME_COST=4
PASSWORD_THREADS=2

# Comma-separated emails that receive the immutable super-admin role after a successful login.
SUPER_ADMIN_EMAILS=owner@example.com

# Use sandbox locally. Switch to iranian only after configuring a compatible provider.
PAYMENT_GATEWAY=sandbox
IRANIAN_GATEWAY_MERCHANT_ID=
IRANIAN_GATEWAY_REQUEST_URL=
IRANIAN_GATEWAY_VERIFY_URL=
IRANIAN_GATEWAY_START_URL=
IRANIAN_GATEWAY_AMOUNT_MULTIPLIER=10
